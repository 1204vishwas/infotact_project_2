# Copy this file to backend/.env and fill in real values.
# Never commit the real backend/.env file.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/proxify
JWT_SECRET=replace_with_a_long_random_secret

# Optional: enables the Socket.io Redis Pub/Sub adapter for multi-instance scaling.
# Leave empty to use the in-memory adapter.
REDIS_URL=
