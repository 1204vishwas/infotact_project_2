# Copy this file to backend/.env and fill in real values.
# Never commit the real backend/.env file.

# PORT is assigned automatically by most hosts (Render/Railway/Fly).
# Local development defaults to 5000 when this is not set.
PORT=5000

# Local MongoDB (development)
MONGODB_URI=mongodb://127.0.0.1:27017/proxify

# Production: use a MongoDB Atlas connection string, e.g.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/proxify?retryWrites=true&w=majority

# Must be a long random string in production, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Optional: enables the Socket.io Redis Pub/Sub adapter AND the Redis-backed
# shared avatar roster for multi-instance scaling.
# Leave empty to use the in-memory adapter and process-local roster.
REDIS_URL=
