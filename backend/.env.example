# Copy this file to backend/.env and fill in real values.
# Never commit the real backend/.env file.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/proxify
JWT_SECRET=replace_with_a_long_random_secret

# MySQL Database Configuration (localhost:3306)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=proxispeak
